{
  "Ai": {
    "Provider": "Ollama",
    "RunTimeoutSeconds": 300,
    "MaxDocumentChars": 14000,
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "qwen3:8b",
      "Temperature": 0,
      "ReasoningEffort": "None"
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "Deployment": "gpt-4.1-mini",
      "ApiKey": "",
      "Temperature": 0,
      "ReasoningEffort": null
    }
  },
  "Rag": {
    "DocsPath": "../../docs",
    "EmbeddingEndpoint": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChunkWords": 300,
    "OverlapWords": 50,
    "TopK": 3
  },
  "ConnectionStrings": {
    "Invoices": "Data Source=invoices.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
